# Kalshi API Credentials (REQUIRED)
KALSHI_API_KEY=your_kalshi_api_key_here
KALSHI_PRIVATE_KEY=your_kalshi_private_key_here
KALSHI_KEY_ID=your_kalshi_key_id_here

# Binance WebSocket (OPTIONAL - for spot price data)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Risk Control Environment Variables (OPTIONAL - have sensible defaults)
# V40_STELLA_BLACK_PCT=0.10
# V40_STELLA_BLACK_LOSS_STREAK=8
# V40_STELLA_RED_PCT=0.05
# V40_STELLA_RED_LOSS_STREAK=5
# V40_STELLA_YELLOW_PCT=0.025
# V40_STELLA_YELLOW_LOSS_STREAK=3

# Paper Trading Mode (DEFAULT)
TRADING_MODE=paper

# Database Paths (auto-created)
# DATABASE_PATH=./data/kalshi_trader.db

# Logging
LOG_LEVEL=INFO